<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:fillViewport="true"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:padding="24dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <com.moadeal.BrandLogoView android:layout_width="170dp" android:layout_height="65dp" android:contentDescription="모아딜" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="동네 이웃과 수요를 모아 판매 제안을 받아보세요." android:paddingVertical="16dp" />
        <RadioGroup android:id="@+id/login_mode" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RadioButton android:id="@+id/mode_login" android:text="로그인" android:checked="true" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" />
            <RadioButton android:id="@+id/mode_signup" android:text="회원가입" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" />
        </RadioGroup>
        <TextView android:id="@+id/login_account_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="화면 검토용입니다. 아래 예시 계정으로 둘러볼 수 있어요." android:paddingVertical="16dp" />
        <EditText android:id="@+id/signup_name" android:hint="이름" android:enabled="false" android:visibility="gone" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="12dp" />
        <EditText android:id="@+id/login_email" android:hint="이메일" android:enabled="false" android:inputType="textEmailAddress" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="12dp" />
        <EditText android:id="@+id/login_password" android:hint="비밀번호" android:enabled="false" android:inputType="textPassword" android:saveEnabled="false" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="12dp" />
        <TextView android:id="@+id/login_account_label" android:text="예시 계정" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Spinner android:id="@+id/login_account" android:layout_width="match_parent" android:layout_height="52dp" />
        <Button android:id="@+id/login_enter" android:text="예시 계정으로 입장" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" />
    </LinearLayout>
</ScrollView>
