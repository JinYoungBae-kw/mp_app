<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:orientation="vertical"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFFFF">
    <LinearLayout android:id="@+id/toolbar" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingHorizontal="10dp"
        android:layout_width="match_parent" android:layout_height="56dp">
        <ImageButton android:id="@+id/back" android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_back" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="뒤로" />
        <TextView android:id="@+id/page_title" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textStyle="bold" android:textSize="19sp" />
        <Button android:id="@+id/toolbar_action" android:layout_width="wrap_content"
            android:layout_height="48dp" android:visibility="gone" />
    </LinearLayout>
    <FrameLayout android:id="@+id/body" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:id="@+id/footer" android:orientation="vertical"
        android:paddingHorizontal="16dp" android:paddingVertical="6dp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <LinearLayout android:id="@+id/navigation" android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/cream" android:visibility="gone" />
</LinearLayout>
