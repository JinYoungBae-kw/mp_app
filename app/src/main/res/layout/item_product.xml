<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="8dp" android:background="@drawable/card_background"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <FrameLayout android:layout_width="match_parent" android:layout_height="140dp">
        <ImageView android:id="@+id/product_photo" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
        <TextView android:id="@+id/product_stage" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:padding="5dp" android:textSize="11sp" android:textColor="#FFFFFF" android:background="@color/brown" />
        <Button android:id="@+id/product_favorite" android:layout_width="44dp" android:layout_height="44dp"
            android:minWidth="0dp" android:padding="0dp" android:layout_gravity="end|top" android:text="♡" android:textSize="24sp" />
    </FrameLayout>
    <TextView android:id="@+id/product_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="40dp" android:gravity="center_vertical" android:textSize="14sp" android:textStyle="bold" android:maxLines="2" />
    <TextView android:id="@+id/product_price" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/brown" android:textSize="17sp" android:textStyle="bold" />
    <TextView android:id="@+id/product_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:maxLines="3" />
</LinearLayout>
