<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="horizontal"
    android:gravity="center_vertical" android:padding="12dp" android:background="@drawable/card_background"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="88dp">
    <ImageView android:id="@+id/row_photo" android:layout_width="64dp" android:layout_height="64dp" android:scaleType="centerCrop" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView android:id="@+id/row_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/row_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:layout_marginTop="5dp" />
    </LinearLayout>
    <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="›" android:textSize="28sp" android:gravity="center" android:textColor="@color/brown" />
</LinearLayout>
